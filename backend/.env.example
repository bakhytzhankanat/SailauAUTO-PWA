# Database (PostgreSQL)
DB_URL=postgresql://localhost:5432/sailau_avto

# JWT
JWT_SECRET=your-secret-min-32-chars-long-for-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001

# CORS (на Render задай URL фронта)
# CORS_ORIGIN=https://sailau-auto-pwa-frontend.onrender.com

# Web Push (generate once with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:owner@example.com

# Сид: супер-админ (только для тебя — админка: список владельцев, создание владельцев).
# Заполни и один раз выполни: npm run seed
# SEED_SUPER_ADMIN_PHONE=+77001234567
# SEED_SUPER_ADMIN_PASSWORD=твой_пароль_от_6_символов
